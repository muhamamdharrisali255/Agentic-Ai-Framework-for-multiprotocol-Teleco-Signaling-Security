# =============================================================================
# Signaling Firewall — environment template
# Copy to .env and adjust. Never commit .env.
# Offline telco tests (scripts/test_telco_offline.py) do NOT require this file.
# =============================================================================

# --- Agentic / stores ---
AGENTIC_RAG=true
POSTGRES_DSN=postgresql://signaling:signaling@localhost:5432/signaling_rag
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=telecom_chunks
USE_QDRANT=true
MONGO_URI=mongodb://signaling:signaling@localhost:27017/signaling_rag?authSource=admin
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=signaling123

# --- Instruction LLM (download weights per models/README.md) ---
LLM_USE_LOCAL=true
LLM_MODEL_PATH=./models/Qwen2.5-14B-Instruct
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_LOAD_IN_4BIT=true
LLM_PRELOAD=true
LLM_BASE_URL=
TEMPERATURE=0.5

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=./models/Qwen-telecom-chatbot-model
EMBEDDING_DEVICE=cuda
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_MIN_RELEVANCE=0.8
RERANK_TOP_K=5
QUERY_ENHANCEMENT_MAX_EXPANSIONS=8
CANDIDATE_SELECTOR_MODE=metadata_filter
CANDIDATE_SELECTOR_MAX_SOURCES=6
CANDIDATE_SELECTOR_MIN_CONFIDENCE=0.35

# --- Optional external judge / telco RAG benchmark ---
# GEMINI_API_KEY=
# TELCO_RAG_URL=http://127.0.0.1:8050/process_query/
